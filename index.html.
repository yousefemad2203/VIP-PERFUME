function toggleProduct(id){const p=products.find(x=>x.id===id);p.available=p.available===false?true:false;saveProducts();renderAdminList();renderProducts()}
async function changeProductImage(id,input){
 const p=products.find(x=>x.id===id),file=input.files&&input.files[0];
 if(!p||!file)return;
 try{
  p.image=await imageFileToDataURL(file);
  saveProducts();
  renderAdminList();
  renderProducts();
  alert("تم تحديث صورة البرفان بنجاح");
 }catch(e){
  alert(e.message||"تعذر تحديث الصورة");
  input.value="";
 }
}
function removeProductImage(id){
 const p=products.find(x=>x.id===id);
 if(!p||!p.image)return;
 if(!confirm("هل تريد حذف صورة هذا البرفان؟"))return;
 p.image="";
 saveProducts();
 renderAdminList();
 renderProducts();
}
function editProduct(id){
 const p=products.find(x=>x.id===id);if(!p)return;
 const name=prompt("اسم البرفان",p.name);if(name===null)return;
 const price=prompt("السعر بالجنيه",p.price);if(price===null)return;
 const category=prompt("التصنيف: "+categories.join(" / "),p.category);if(category===null)return;
 const currentIsUpload=(p.image||"").startsWith("data:");
 const image=prompt("رابط صورة البرفان الجديد (اتركه فارغاً للاحتفاظ بالصورة الحالية، أو اكتب رابطاً جديداً)",currentIsUpload?"":(p.image||""));if(image===null)return;
 p.name=name.trim()||p.name;p.price=Math.max(0,Number(price)||0);p.category=categories.includes(category.trim())?category.trim():p.category;if(image.trim())p.image=image.trim();
 saveProducts();renderAdminList();renderProducts();
 const picker=document.createElement("input");picker.type="file";picker.accept="image/*";
 picker.onchange=async()=>{if(!picker.files||!picker.files[0])return;try{p.image=await imageFileToDataURL(picker.files[0]);saveProducts();renderAdminList();renderProducts();alert("تم تحديث صورة المنتج") }catch(e){alert(e.message||"تعذر تحميل الصورة")}};
 if(confirm("هل تريد أيضاً اختيار صورة من جهازك؟ اضغط موافق لاختيار الصورة أو إلغاء للاحتفاظ بالرابط/الصورة الحالية."))picker.click();
}
async function imageFileToDataURL(file){
 if(!file.type.startsWith("image/"))throw new Error("من فضلك اختر ملف صورة صالحاً");
 if(file.size>15*1024*1024)throw new Error("حجم الصورة كبير جداً. اختر صورة أقل من 15 ميجابايت.");
 const source=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>reject(new Error("تعذرت قراءة الصورة"));r.readAsDataURL(file)});
 const img=await new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>resolve(im);im.onerror=()=>reject(new Error("ملف الصورة غير صالح"));im.src=source});
 const scale=Math.min(1,1000/Math.max(img.width,img.height));const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));
 canvas.getContext("2d").drawImage(img,0,0,canvas.width,canvas.height);
 return canvas.toDataURL("image/webp",0.82);
}
async function addProduct(){
 const name=document.getElementById("newName").value.trim(),price=Number(document.getElementById("newPrice").value);
 if(!name||!Number.isFinite(price)||price<0){alert("اكتب اسم المنتج وسعراً صحيحاً");return}
 const id=Math.max(0,...products.map(p=>Number(p.id)||0))+1;
 const file=document.getElementById("newImageFile").files[0];
 const product={id,sku:document.getElementById("newSku").value.trim(),name,price,category:document.getElementById("newCategory").value,available:true,image:document.getElementById("newImage").value.trim()};
 if(file){try{product.image=await imageFileToDataURL(file)}catch(e){alert(e.message||"تعذر تحميل الصورة");return}}
 products.unshift(product);
 try{saveProducts()}catch(e){products.shift();alert("مساحة حفظ الصور في المتصفح غير كافية. جرّب صورة أصغر أو استخدم رابط صورة.");return}
