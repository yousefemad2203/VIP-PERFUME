let products = loadProducts(), activeCategory = "OUT LET", cart = {};
function loadProducts(){try{const saved=localStorage.getItem("vip_perfume_products");return saved?JSON.parse(saved):DEFAULT_PRODUCTS.map(p=>({...p}))}catch(e){return DEFAULT_PRODUCTS.map(p=>({...p}))}}
function saveProducts(){localStorage.setItem("vip_perfume_products",JSON.stringify(products))}
function money(n){return Number(n).toLocaleString("en-US",{maximumFractionDigits:2})+" ج.م"}
function safe(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function renderCategories(){
 document.getElementById("categories").innerHTML=categories.map(c=>`<button class="cat ${c===activeCategory?'active':''}" onclick="selectCategory('${c}')">${c}</button>`).join("");
 document.getElementById("newCategory").innerHTML=categories.map(c=>`<option>${c}</option>`).join("");
}
function selectCategory(c){activeCategory=c;renderCategories();renderProducts()}
function bottle(){return `<div class="bottle"><div class="cap"></div><div class="neck"></div><div class="glass"></div></div>`}
function renderProducts(){
 const q=document.getElementById("search").value.trim().toLowerCase();
 const list=products.filter(p=>p.category===activeCategory&&p.available!==false&&(p.name.toLowerCase().includes(q)||String(p.sku).includes(q)));
 document.getElementById("resultCount").textContent=`${list.length} منتج`;
 document.getElementById("products").innerHTML=list.length?list.map(p=>`<article class="product">
  <div class="photo">${p.image?`<img src="${safe(p.image)}" alt="${safe(p.name)}" onerror="this.remove()">`:bottle()}</div>
  <div class="product-info"><span class="sku">كود الصنف: ${safe(p.sku||"—")}</span><h3>${safe(p.name)}</h3>
  <div class="price">${p.price>0?money(p.price):'السعر غير محدد'}</div><div class="stock">متاح للطلب · ${safe(p.category)}</div>
  <div class="buyrow"><input class="qty" id="qty-${p.id}" type="number" min="1" max="99" value="1" aria-label="الكمية"><button class="add" ${p.price<=0?'disabled':''} onclick="addToCart(${p.id})">أضف للسلة</button></div></div></article>`).join(""):`<div class="empty">لا توجد منتجات متاحة في هذا التصنيف حالياً.</div>`;
}
function addToCart(id){const p=products.find(x=>x.id===id);const q=Math.max(1,Math.min(99,parseInt(document.getElementById("qty-"+id).value)||1));cart[id]=(cart[id]||0)+q;updateCartCount();toast("تمت إضافة المنتج إلى السلة")}
function updateCartCount(){document.getElementById("cartCount").textContent=Object.values(cart).reduce((a,b)=>a+b,0)}
function openCart(){renderCart();document.getElementById("cartOverlay").classList.add("show")}
function renderCart(){
 const entries=Object.entries(cart).filter(([id,q])=>q>0).map(([id,q])=>({p:products.find(p=>p.id===Number(id)),q})).filter(x=>x.p);
 document.getElementById("cartItems").innerHTML=entries.length?entries.map(({p,q})=>`<div class="cart-line"><div><b>${safe(p.name)}</b><small>${q} × ${money(p.price)}</small><button class="btn tiny" onclick="changeCart(${p.id},-1)">−</button> <button class="btn tiny" onclick="changeCart(${p.id},1)">+</button> <button class="btn tiny" onclick="removeCart(${p.id})">حذف</button></div><b>${money(p.price*q)}</b></div>`).join(""):'<div class="empty">السلة فارغة، اختار البرفانات اللي محتاجها.</div>';
 const total=entries.reduce((s,x)=>s+x.p.price*x.q,0);document.getElementById("cartTotal").textContent=money(total);
}
function changeCart(id,d){cart[id]=Math.max(0,(cart[id]||0)+d);if(!cart[id])delete cart[id];updateCartCount();renderCart()}
function removeCart(id){delete cart[id];updateCartCount();renderCart()}
function sendOrder(){
 const entries=Object.entries(cart).filter(([id,q])=>q>0).map(([id,q])=>({p:products.find(p=>p.id===Number(id)),q})).filter(x=>x.p);
 if(!entries.length){alert("السلة فارغة");return}
 const name=document.getElementById("customerName").value.trim(),phone=document.getElementById("customerPhone").value.trim(),address=document.getElementById("customerAddress").value.trim();
 if(!name||!phone||!address){alert("من فضلك اكتب الاسم ورقم الموبايل والعنوان");return}
 const total=entries.reduce((s,x)=>s+x.p.price*x.q,0);
 let msg=`طلب جديد من VIP PERFUME%0Aالاسم: ${encodeURIComponent(name)}%0Aالموبايل: ${encodeURIComponent(phone)}%0Aالعنوان: ${encodeURIComponent(address)}%0A%0Aالمنتجات:%0A`;
 entries.forEach(({p,q})=>{msg+=`- ${encodeURIComponent(p.name)} | التصنيف: ${encodeURIComponent(p.category)} | الكمية: ${q} | السعر: ${encodeURIComponent(money(p.price))}%0A`});
 msg+=`%0Aالإجمالي: ${encodeURIComponent(money(total))}`;
 window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`,"_blank");
}
