function renderAdminList(){
 const q=(document.getElementById("adminSearch").value||"").toLowerCase();
 const list=products.filter(p=>p.name.toLowerCase().includes(q)||String(p.sku).includes(q)).slice(0,150);
 document.getElementById("adminList").innerHTML=list.map(p=>`<div class="admin-item">
   <span>${safe(p.name)}<br><small>${safe(p.category)} · ${money(p.price)} · ${p.image?'لها صورة':'بدون صورة'}</small></span>
   <div class="admin-actions">
    <button class="toggle ${p.available===false?'off':''}" onclick="toggleProduct(${p.id})">${p.available===false?'غير متاح':'متاح'}</button>
